# Copy this file to ".env" (same folder) and edit. Never commit real keys.
SEED_PASSWORD=change-me-to-a-long-password
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
HOST_PORT=8080

# --- AI (free): create a key at https://console.groq.com  (no credit card) ---
# GROQ_API_KEY=gsk_...
# Model IDs change often (Groq retires models). Comma list = fallback chain. Check console.groq.com/docs/models
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# GROQ_VISION_MODELS=qwen/qwen3.8-27b
# LLM_USER_PER_HOUR=30
# LLM_DAILY_CAP=400

# --- Alerts for HIGH/CRITICAL incidents (optional) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=        # Slack / Discord incoming webhook
# ALERT_MIN_SEVERITY=HIGH
# PUBLIC_URL=https://your-app.example.com

# --- Public demo ---
# DEMO_MODE=1               # sample mission + read-only "demo" login button

# --- Real footage (needs: INSTALL_YOLO=1 then `docker compose up --build`) ---
# INSTALL_YOLO=1
# DETECTOR=yolo
# YOLO_IMGSZ=960
# BLUR_PERSONS=1
